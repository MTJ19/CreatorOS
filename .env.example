# ============================================================
# CreatorOS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=CreatorOS

# ─── API (NestJS) ───────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT / session secret (min 32 chars) — generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── NextAuth.js (Next.js Web) ───────────────────────────────
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creator_os_dev?schema=public

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AWS S3 (contract / invoice file storage) ───────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=creator-os-files

# ─── AI / Gemini API ────────────────────────────────────────
GEMINI_API_KEY=

# ─── OpenAI (fallback) ──────────────────────────────────────
OPENAI_API_KEY=

# ─── Email (Resend / SendGrid) ──────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@creatoros.app

# ─── Stripe (invoicing / payments) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── Sentry (error tracking) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Web (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Turborepo Remote Cache (optional) ──────────────────────
TURBO_TOKEN=
TURBO_TEAM=
